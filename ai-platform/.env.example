# AI Governance Plane Environment Variables

# Environment: development | staging | production
# Strict Rule: local dev login is only enabled when ENVIRONMENT=development
ENVIRONMENT=development

# agentgateway Administrative URL
AGENTGATEWAY_ADMIN_URL=http://127.0.0.1:8081

# JWT Secret Key (min 32 characters)
JWT_SECRET=super-secret-governance-plane-key-32chars-min!!

# JWT Expiration in seconds (default: 3600 = 1 hour)
JWT_EXPIRATION_SECONDS=3600

# Reconciliation Polling Interval in seconds
RECONCILE_INTERVAL=15

# Optional Solo Enterprise Integration
SOLO_ENTERPRISE_ENABLED=false
